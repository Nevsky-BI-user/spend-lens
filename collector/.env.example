# spend-lens collector — Supabase push credentials.
# Copy this file to collector/.env and fill in real values (collector/.env is gitignored — NEVER commit it).
# Values live in Supabase Dashboard → Project Settings → API.
# When collector/.env is absent or empty, the collector silently skips the Supabase push.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
