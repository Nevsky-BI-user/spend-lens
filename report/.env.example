# spend-lens report — SMTP-налаштування (Gmail, smtp.gmail.com:465)
# Скопіюй у report/.env і заповни. report/.env — у .gitignore, НЕ комітиться.
#
# SMTP_APP_PASSWORD — «пароль застосунку» Google (НЕ звичайний пароль акаунта):
#   https://myaccount.google.com/apppasswords
# Якщо змінні не задано — звіт усе одно згенерує PDF, а надсилання пошти
# буде пропущено (лог «email пропущено», exit 0).

REPORT_TO=you@example.com
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=
