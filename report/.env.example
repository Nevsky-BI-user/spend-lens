# spend-lens report — SMTP-налаштування (Gmail, smtp.gmail.com:465)
# Скопіюй у report/.env і заповни. report/.env — у .gitignore, НЕ комітиться.
#
# SMTP_APP_PASSWORD — «пароль застосунку» Google (НЕ звичайний пароль акаунта):
#   https://myaccount.google.com/apppasswords
# Якщо змінні не задано — звіт усе одно згенерує PDF, а надсилання пошти
# буде пропущено (лог «email пропущено», exit 0).

REPORT_TO=you@example.com
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=

# MONTHLY_BUDGET_USD — місячний бюджет витрат у USD (CONTRACT v1.6 §2).
# Якщо задано, у PDF з'являється картка «Бюджет місяця» (звіт друкується з
# &budget=<сума>), а в тілі листа — рядок «за поточним темпом місяць
# закриється на $X». Порожньо або 0 = бюджет вимкнено. Річне зведення
# бюджету не показує: він місячний.
MONTHLY_BUDGET_USD=
